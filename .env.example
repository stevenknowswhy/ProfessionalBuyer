# Copy to .env and fill in. Never commit .env.
# Where to get each value, and which are required: KEYS.md.
# Everything runs without keys: each missing key switches that service to a labeled fallback.

# --- Neon: Postgres (required for real data) -------------------------------
# `npx neon@latest init` or `neon env pull` writes these two.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Neon AI Gateway: LLM calls (needs paid plan + supported region) -------
# Create with: neon credentials create --scope ai_gateway:invoke
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
LLM_MODEL_FAST=
LLM_MODEL_CHAT=

# --- LLM. OpenAI is the default; OpenRouter's free router is the fallback. ---
# The app tries OpenAI first and falls back to OpenRouter on a rate limit, an
# outage, or a missing key. openrouter/free picks a free model that supports the
# request's features (tool calling, structured output).
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# --- Exa: live price search ------------------------------------------------
EXA_API_KEY=

# --- Kernel: cloud browser for price verification and checkout -------------
KERNEL_API_KEY=
# Name of the Kernel Vault item that holds the payment method (never the card itself).
KERNEL_VAULT_PAYMENT_ITEM=

# --- AgentMail: the agent's inbox ------------------------------------------
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Where the daily briefing and watch alerts are sent (your own email).
BRIEFING_TO_EMAIL=

# --- Fly.io and Sprites: always-on price-watch worker ----------------------
# Fly account token (starts with "FlyV1 "). Does not work against api.sprites.dev.
FLY_API_TOKEN=
# Sprites org token from https://sprites.dev/account (org-slug/org-id/token-id/secret).
SPRITES_TOKEN=
SPRITE_NAME=buyer-worker

# --- Executor (v1, runs locally next to the agent server) ------------------
EXECUTOR_MCP_URL=http://127.0.0.1:4788/mcp

# --- Laya sidecar (local). Unset to use LLM triage instead. ----------------
LAYA_URL=http://127.0.0.1:8787

# --- Spending controls -----------------------------------------------------
CHECKOUT_MODE=review
SPEND_CAP_USD=25
# Comma-separated merchant hostnames allowed for checkout.
MERCHANT_ALLOWLIST=

# --- App wiring -------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:4111
# 1 = the web app uses contract/fixtures (labeled "Sample data") instead of the API.
NEXT_PUBLIC_USE_FIXTURES=0
# 1 = replay recorded responses, always labeled "Replayed" in the UI.
DEMO_SAFE=0
